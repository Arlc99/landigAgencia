# ─── Servidor (NUNCA llevan prefijo VITE_) ───
# API key de Groq (la misma del chatbot): https://console.groq.com/keys
GROQ_API_KEY=tu_api_key
# Modelo de Groq para el diagnóstico (debe soportar json_schema estricto)
GROQ_MODEL=openai/gpt-oss-120b
# URL del despliegue web de Google Apps Script (termina en /exec)
GOOGLE_SHEETS_WEBHOOK_URL=tu_webhook_url
# Secreto compartido con Apps Script (opcional pero recomendado; mismo valor en Propiedades del script → WEBHOOK_SECRET)
GOOGLE_SHEETS_WEBHOOK_SECRET=
# Orígenes permitidos separados por coma (opcional)
ALLOWED_ORIGINS=

# Formulario de contacto de la landing (Apps Script distinto al del diagnóstico)
CONTACT_WEBHOOK_URL=tu_webhook_de_contacto
CONTACT_WEBHOOK_SECRET=nuevo_token_largo_y_aleatorio

# ─── Captcha anti-bots: Cloudflare Turnstile (gratis) ───
# Créalo en https://dash.cloudflare.com → Turnstile → Add widget (tipo "Managed", dominios: tu sitio y localhost).
# Clave secreta (solo servidor). Si está vacía, el captcha queda apagado.
TURNSTILE_SECRET_KEY=
# Clave del sitio (pública por diseño; lleva el prefijo VITE_ porque se usa en el navegador)
VITE_TURNSTILE_SITE_KEY=
